  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p><span style=\"font-family: arial;\">וּפִתְאוֹם<br /></span><span style=\"font-family: arial;\">תָּבוֹא הָעֵת<br /></span><span style=\"font-family: arial;\">וְיָפוּג הָעֶצֶב.</span></p><p><span style=\"font-family: arial;\">וּכְבַחֲלוֹם<br /></span><span style=\"font-family: arial;\">בְּשׂוֹרָה נִשֵּׂאת<br /></span><span style=\"font-family: arial;\">וְזֶמֶר וְקֶצֶב.</span></p><p><span style=\"font-family: arial;\">יָבוֹאוּ רְחוֹקִים<br /></span><span style=\"font-family: arial;\">יָשׁוּבוּ נִדָּחִים<br /></span><span style=\"font-family: arial;\">יַחְזְרוּ לְחַיִּים.</span></p></div><div class=\"separator\" style=\"clear: both;\"><br /></div><div class=\"separator\" style=\"clear: both;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">לְעוֹלָם אַל תְּאַבֵּד תִּקְוָה לִפְגּוֹשׁ אֶת מִי שֶׁנֶּעֱלַם.</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">יֵשׁ וְהָרִחוּק הוּא רַק דֶּרֶךְ עֲקַלְקַלָּה לְקִרְבָה יְתֵרָה</span></div></div><div class=\"separator\" style=\"clear: both;\"><br /></div><div class=\"separator\" style=\"clear: both;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><div><span style=\"font-family: arial;\">מִן הַבֶּכִי הָעָצוּר - נוֹלַד צְחוֹק שֶׁל גְּאֻלָּה</span></div><div><span style=\"font-family: arial;\"><br /></span></div></span><div><h2><span><span><span style=\"background-color: #fff2cc; font-family: arial; font-size: large;\">💎 פנינה</span></span></span></h2><span style=\"font-family: arial;\">\"עוֹד יוֹסֵף בְּנִי חָי\" = 316 = \"חָבוּשׁ\"</span></div><div><span><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"><br /></span></p><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"></span></p></span><ol><li><span style=\"font-family: arial;\">'<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>וַיִּגַּשׁ</b></span>' / '<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>וּקְרֵיב</b></span>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖ כמו מגש הנושא תקרובת</span><span style=\"background-color: white; font-family: arial;\">.</span></li><li><span style=\"font-family: arial;\">'<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>וַנַּגֶּד</b></span>' / '<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>וְחַוִּינָא</b></span>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;אמרנו, הבענו, שיתפנו - חיווינו דעתנו.</span></li><li><span style=\"font-family: arial;\">'<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>בְּיָגוֹן</b></span>' / '<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>בְּדָווֹנָא</b></span>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;בצער, בכאב - במדווה.</span></li><li><span style=\"font-family: arial;\">'<b><span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\">לְהִתְאַפֵּק</span></b>' / '<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>לְאִתְחַסָּנָא</b></span>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;להתגבר, להתחזק - להתחסן</span><span style=\"background-color: white; font-family: arial;\">.</span></li><li><span style=\"font-family: arial;\">'<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>צֵדָה</b></span>' / '<span face=\"Arial, Helvetica, sans-serif\" style=\"background-color: white; color: #222222;\"><b>וּזְוָדִין</b></span>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;מזון משומר במזווה (מחסן) או במזוודה (תרמיל).</span></li></ol><div><br /></div><span style=\"font-family: arial;\"></span><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">👁️ מבט חד</span><br /></h2><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"/assets/images/content/c98892cbbea6ed098c.png\" imageanchor=\"1\" style=\"clear: right; float: right; margin-bottom: 1em; margin-left: 1em;\"><img alt=\"דלת עץ כבדה ועתיקה, פתוחה מעט, וממנה בוקע אור זהוב מסנוור שמציף את החדר החשוך\" border=\"0\" data-original-height=\"1024\" data-original-width=\"1024\" height=\"200\" src=\"/assets/images/content/c98892cbbea6ed098c.png\" width=\"200\" /></a></div><div class=\"separator\" style=\"clear: both;\"><br /></div></span></div></div>"
}
