  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both; text-align: center;\"><h2 style=\"text-align: right;\"><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">עוֹשִׂים<br /></span><span style=\"font-family: arial;\">עֶגְלֵי זָהָב.</span></p><p style=\"text-align: right;\"><span style=\"font-family: arial;\">יוֹצְרִים<br /></span><span style=\"font-family: arial;\">עֶגְלֵי כָּזָב.</span></p><p style=\"text-align: right;\"><span style=\"font-family: arial;\">דּוֹרְשִׁים<br /></span><span style=\"font-family: arial;\">כָּאן וְעַכְשָׁו.</span></p><p style=\"text-align: right;\"><span style=\"font-family: arial;\">עוֹמְדִים<br /></span><span style=\"font-family: arial;\">מוּל נַחַל אַכְזָב</span><span style=\"font-family: arial;\">.</span></p><h2 style=\"font-family: Arial, sans-serif; text-align: right;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><p></p><span data-end=\"167\" data-start=\"145\"><div style=\"text-align: right;\"><span style=\"font-family: arial;\">הִזָּהֵר מֵהָאֱלִילִים שֶׁבָּנִיתָ - הֵם יִקְרְסוּ בְּדִיּוּק כְּשֶׁתִּזְדַּקֵּק לָהֶם.</span></div></span><p></p><h2 style=\"font-family: Arial, sans-serif; text-align: right;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><p style=\"text-align: right;\"><span style=\"background-color: #fff2cc; font-family: arial;\"></span></p><div style=\"text-align: right;\"><div><span style=\"font-family: arial;\">הַנּוֹצֵץ קוֹרֵץ -</span></div><div><span style=\"font-family: arial;\">הָאוֹר קוֹרֵא.</span></div></div><div style=\"text-align: right;\"><span style=\"font-family: arial;\"><br /></span></div><div style=\"text-align: right;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2></span><p><span style=\"font-family: arial;\">\"וַיַּרְא הָעָם כִּי בֹשֵׁשׁ מֹשֶׁה לָרֶדֶת מִן הָהָר וַיִּקָּהֵל הָעָם עַל אַהֲרֹן וַיֹּאמְרוּ אֵלָיו קוּם עֲשֵׂה לָנוּ אֱלֹהִים אֲשֶׁר יֵלְכוּ לְפָנֵינוּ כִּי זֶה מֹשֶׁה הָאִישׁ אֲשֶׁר הֶעֱלָנוּ מֵאֶרֶץ מִצְרַיִם לֹא יָדַעְנוּ מֶה הָיָה לוֹ\" (שמות ל\"ב א)</span></p><p><span style=\"font-family: arial;\">&nbsp;<i>\"בָּא שָׂטָן ... וְהֶרְאָה דְּמוּת חֹשֶׁךְ וַאֲפֵלָה ... לוֹמַר וַדַּאי מֵת מֹשֶׁה ...&nbsp;כְּמִין דְּמוּת מֹשֶׁה הֶרְאָה לָהֶם הַשָּׂטָן, שֶׁנּוֹשְׂאִים אוֹתוֹ בַּאֲוִיר רְקִיעַ הַשָּׁמָיִם\" </i>(רש\"י)</span></p><p><span style=\"font-family: arial;\">\"<i>כִּי זֶה מֹשֶׁה הָאִישׁ אֲשֶׁר הֶעֱלָנוּ מֵאֶרֶץ מִצְרַיִם לֹא יָדַעְנוּ מֶה הָיָה לוֹ</i>\" = 2348 =&nbsp;שהראה להם השטן מטתו של משה רבנו (בעל הטורים)</span></p><span><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span><b style=\"font-family: arial;\">&nbsp;</b></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p style=\"font-family: arial;\"><span face=\"Arial, sans-serif\"></span></p></span><ol style=\"box-sizing: border-box; counter-reset: templateify 0; margin: 10px 0px; padding: 0px 20px 0px 0px;\"><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">בֹשֵׁשׁ</b>' / '<b style=\"background-color: white;\">אוֹחַר</b>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖ התמהמה, התעכב - התאחר</span></span></span></li><li><span style=\"font-family: arial;\">'<b>מַסֵּכָה</b>' / '<b>מַתְּכָא</b>'<br /><span><span><span style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span style=\"background-color: white;\">&nbsp;יציקה של מתכת מותכת</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">שִׁחֵת</b>' / '<b style=\"background-color: white;\">חַבֵּיל</b>'<br /><span><span><span style=\"background-color: white;\">❖ קלקול, הֶרֶס - חבלה</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">מְחֹלֹת</b>' / '<b style=\"background-color: white;\">חִנְגִין</b>'<br /><span><span><span style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span style=\"background-color: white;\">&nbsp;ריקוד (במעגל), חגיגה - חינגה</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b>אֵשׁ</b>' / '<b>נוּרָא</b>'<br /><span><span><span style=\"background-color: white;\">❖ אש - נור</span></span></span></span></li></ol><span><div style=\"font-family: arial;\"><br /></div><h2 style=\"display: inline; font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\"><div><span style=\"font-family: arial;\"></span></div>👁️ מבט חד</span></h2><br /></span><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"/assets/images/content/e2bd95e6b1b63f0a54.png\" style=\"clear: right; float: right; margin-bottom: 1em; margin-left: 1em;\"><img alt=\"טלפון נייד מונח על שולחן כהה, ועל המסך מופיע אייקון מוזהב של עגל\" border=\"0\" data-original-height=\"1024\" data-original-width=\"1024\" height=\"200\" src=\"/assets/images/content/e2bd95e6b1b63f0a54.png\" width=\"200\" /></a></div><br /><br /></div><div><span><span style=\"font-family: arial;\"><br /></span></span></div></div>"
}
