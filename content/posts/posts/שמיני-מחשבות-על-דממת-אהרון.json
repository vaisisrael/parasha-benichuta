  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhjiYJPAm84oR3355jnNlHmNwiPqVmvALUOfbGD4zU52Ki1L4KhkX-u7PehC4FMyNeLEWRp7902hChkHdOJkXbvYISL4fC3sW1R-KGIJ0pmghlHxc-GjbvJnWnrLtbgtAorCJfU9-uyj4NXxingMIUxQOuOLMcckSrr5WGrDqnQRyK-xKVDlJtvJuN8_pQ/w200-h183/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">פְּעָמִים,<br /></span><span style=\"font-family: arial;\">צַדִּיק גּוֹזֵר<br /></span><span style=\"font-family: arial;\">- שְׁתִיקָה עַל עַצְמוֹ.</span></p><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">עִתִּים,<br /></span><span style=\"font-family: arial;\">וָתִיק חוֹזֵר<br /></span><span style=\"font-family: arial;\">- בְּדוּמִיָּה לְאֶבְלוֹ.</span></p><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">פְּרָקִים,<br /></span><span style=\"font-family: arial;\">שֶׁהוּא מְבַעֵר<br /></span><span style=\"font-family: arial;\">- תְּלוּנָה מִלִּבּוֹ.</span></p></div><div class=\"separator\" style=\"clear: both;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><p data-end=\"128\" data-start=\"39\"><span style=\"font-family: arial;\">לִפְנֵי תְּגוּבָה - בְּדִבּוּר, בִּכְתִיבָה אוֹ בְּמַחֲשָׁבָה -<br /></span><span style=\"font-family: arial;\">שְׁאַל: הַאִם הַמִּלִּים מוֹסִיפוֹת אוֹר אוֹ רַק פּוֹרְקוֹת כְּאֵב?</span></p><p data-end=\"128\" data-start=\"39\"><span style=\"font-family: arial;\">אִם אֵינְךָ בָּטוּחַ,<br /></span><span style=\"font-family: arial;\">בְּחַר רֶגַע שֶׁל שְׁתִיקָה.<br /></span><span style=\"font-family: arial;\">לֹא כִּבְרִיחָה, אֶלָּא כִּבְרֵרָה.</span></p><p data-end=\"128\" data-start=\"39\"><span style=\"font-family: arial;\">לִפְעָמִים, כְּמוֹ אֵצֶל אַהֲרֹן,<br /></span><span style=\"font-family: arial;\">הַשְּׁתִיקָה אֵינָהּ חֻלְשָׁה -<br /></span><span style=\"font-family: arial;\">הִיא עֲבוֹדַת קֹדֶשׁ..</span></p></div><div class=\"separator\" style=\"clear: both;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">יֵשׁ שְׁתִיקָה הַבּוֹנָה מִזְבֵּחַ,<br /></span><span style=\"font-family: arial;\">וְיֵשׁ שְׁתִיקָה הַקּוֹבֶרֶת אֵשׁ.</span></p></span><div><span><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2></span></span><p style=\"text-align: right;\"><span style=\"font-family: arial;\">\"וַיִּדֹּם אַהֲרֹן\" = 316 = \"וַנִצְעַק\"</span></p></div><div><span><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"></span></p></span><ol><li><span style=\"font-family: arial;\">'<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">וַיִּדֹּם</span></b></i>' / '<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">וּשְׁתֵיק</span></b></i>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖ דממה, שקט - שתיקה</span></span>.</span></span></span></li><li><span style=\"font-family: arial;\">'<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">זָרָה</span></b></i>' / '<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">נֻכְרֵיתָא</span></b></i>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;נכרית, חיצונית, שונה - זרה.</span></span></span></li><li><span style=\"font-family: arial;\">'<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">שְׂאוּ</span></b></i>' / '<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">טוּלוּ</span></b></i>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;לשאת, להרים - ליטול.</span></span></span></li><li><span style=\"font-family: arial;\">'<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">קַשְׂקֶשֶׂת</span></b></i>' / '<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">קַלְפִין</span></b></i>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;קשקשים - קליפות</span><span style=\"background-color: white;\">.</span></span></span></li><li><span style=\"font-family: arial;\">'<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">שָּׁלָךְ</span></b></i>' / '<i style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; color: #626262; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">שָׁלֵינוּנָא</span></b></i>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;עוף השולה דגים - \"שָׁלֵי נוּנָא\".</span></span></span></li></ol><span><h2 style=\"font-family: Arial, sans-serif;\">👁️ מבט חד<br /></h2></span></div></div><div class=\"separator\" style=\"clear: both;\"><span><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi_BLyIQp7gJSOav-qYum6waAv6Os7Fst_Nj7WOBP9hmQOkbjhQlPbhnE7DfpmuaJfBDi9HSvv8XFkgKMOYwn2NOCuDtOCewHAn3Y4cGFmRxl_LfwJRM5ezMIdNpYYHLyqaCv2JO_mu7GTAoem7jUDNLLOA9nW2LnH3n0p6qzx7FsoiQ4JFbVSrZn3638I/s363/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" style=\"clear: right; float: right; margin-bottom: 1em; margin-left: 1em; text-align: right;\"><img alt=\"איור מינימליסטי של חסיד חובש כובע שחור, ראשו מורכן ובועת דיבור ריקה מעליו, על רקע בהיר – ביטוי לשתיקה מהורהרת\" border=\"0\" data-original-height=\"221\" data-original-width=\"363\" height=\"122\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi_BLyIQp7gJSOav-qYum6waAv6Os7Fst_Nj7WOBP9hmQOkbjhQlPbhnE7DfpmuaJfBDi9HSvv8XFkgKMOYwn2NOCuDtOCewHAn3Y4cGFmRxl_LfwJRM5ezMIdNpYYHLyqaCv2JO_mu7GTAoem7jUDNLLOA9nW2LnH3n0p6qzx7FsoiQ4JFbVSrZn3638I/w200-h122/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" width=\"200\" /></a></div><br /><span style=\"font-family: arial;\"><br /></span></span></div>"
}
