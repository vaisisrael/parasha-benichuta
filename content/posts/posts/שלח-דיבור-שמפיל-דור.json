  "content_html": "<p style=\"text-align: center;\">&nbsp;&nbsp;<span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p data-end=\"789\" data-start=\"705\"><span style=\"font-family: arial;\">אַל תּוֹצִיא דִּבָּה<br /></span><span style=\"font-family: arial;\">עַל הָאָרֶץ<br /></span><span style=\"font-family: arial;\">וְיוֹשְׁבֶיהָ.</span></p><p data-end=\"789\" data-start=\"705\"><span style=\"font-family: arial;\">אַל תְּדַבֵּר סָרָה<br /></span><span style=\"font-family: arial;\">בָּאָרֶץ<br /></span><span style=\"font-family: arial;\">וַאֲנָשֶׁיהָ.</span></p><p data-end=\"789\" data-start=\"705\"><span style=\"font-family: arial;\">כִּי עֵינֵי אֱלֹהֶיךָ בָּהּ<br /></span><span style=\"font-family: arial;\">בָּאָרֶץ<br /></span><span style=\"font-family: arial;\">וּבְבָנֶיהָ.</span></p><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><p></p><span style=\"font-family: arial;\"><p style=\"clear: both;\">לִפְנֵי שֶׁאַתָּה מְדַבֵּר עַל מָקוֹם,<br />עַל קְהִלָּה,<br />אוֹ עַל עַם -<br />זְכֹר שֶׁאַתָּה מְדַבֵּר גַּם עַל אֲנָשִׁים.</p><p style=\"clear: both;\">בְּדֹק אִם הַמִּלִּים שֶׁלְּךָ<br />בּוֹנוֹת לָהֶם בַּיִת<br />אוֹ פּוֹצְעוֹת לָהֶם אֲדָמָה.</p></span><p></p><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><p><span style=\"background-color: #fff2cc; font-family: arial;\"></span></p><p><span style=\"font-family: arial;\"><span style=\"background-color: white; color: #202122; text-align: -webkit-center;\">\"<span style=\"text-align: start;\">וּמוֹצִא דִבָּה הוּא כְסִיל</span>\" (משלי י, י\"ח)</span></span></p><div><span style=\"font-family: arial;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2></span><p style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; margin: 0px 0px 25px; outline: none; padding: 0px; text-align: right; vertical-align: baseline;\"><span style=\"font-family: arial;\">הפרשה הקודמת - בהעלתך, מסתיימת בסיפור צרעת מרים.<br /></span><span style=\"font-family: arial;\">פרשתנו - פותחת בסיפור שליחת המרגלים.</span></p><p style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; margin: 0px 0px 25px; outline: none; padding: 0px; text-align: right; vertical-align: baseline;\"><span style=\"font-family: arial;\">סמכן הכתוב, כי בשתיהן דיברו לשון הרע (עפ\"י בעל הטורים).</span></p></div><div><span style=\"font-family: arial;\"><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-family: &quot;Times New Roman&quot;; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">&nbsp;</span></b></i></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-family: &quot;Times New Roman&quot;; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><b><span face=\"Arial, sans-serif\"></span></b></p><ol style=\"box-sizing: border-box; counter-reset: templateify 0; margin: 10px 0px; padding: 0px 20px 0px 0px;\"><li><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><span><span>'</span><span><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">חָזָק</span></b></i>' / '</span><span><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">תַקִּיף</span></b></i>'</span></span><br /></span></span><span>❖ גבורה, איתנות - תֹּקֶף</span></span></li><li><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><span>'<span style=\"color: #222222;\"><b>דִבָּה</b></span>' / '<span style=\"color: #222222;\"><b>שׁוֹם בִּישׁ</b></span>'</span><br /></span></span><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span>&nbsp;הוצאת שם רע (מביש)</span></span></li><li><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>'</span><span><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">לוּ</span></b></i>' / '<i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">לְוֵי</span></b></i>'</span><br /></span><span>❖ לו - הלוואי</span></span></li><li><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><span><span>'<i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">אַכֶּנּוּ</span></b></i>' / '<i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">אֶמְחֵינוּן</span></b></i>'</span></span><br /></span></span><span style=\"background-attachment: initial; background-clip: initial; background-image: initial; background-origin: initial; background-position: 0px 0px; background-repeat: initial; background-size: initial; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span>&nbsp;הכאה - מְחִיָּה</span></span></li><li><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>'<i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">מַלִּינִים</span></b></i>' / '<i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><b><span style=\"color: #222222; font-style: normal;\">מִתְרָעֲמִין</span></b></i>'</span><br /></span><span>❖ מתלוננים, רוטנים - מתרעמים</span></span></li></ol><div><br /></div><h2 style=\"display: inline; font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\"><div><span style=\"font-family: arial;\"></span></div>👁️ מבט חד</span><br /></h2><div style=\"font-family: &quot;Times New Roman&quot;;\"><br /></div></span></div></div><div class=\"separator\" style=\"clear: both; text-align: right;\"><a href=\"/assets/images/content/164a4a82fdc3f9fadf.png\" imageanchor=\"1\" style=\"clear: right; float: right; margin-bottom: 1em; margin-left: 1em;\"><img alt=\"איור של מסך סמארטפון עם התראה: “רוצה לפרסם ביקורת על המקום הזה?”, ושני כפתורים – “פרסם” ו“בדוק שוב”, כאשר האצבע מרחפת מעל “בדוק שוב”, כרמז לעצירה לפני דיבה ולשון הרע\" border=\"0\" data-original-height=\"421\" data-original-width=\"400\" height=\"200\" src=\"/assets/images/content/164a4a82fdc3f9fadf.png\" width=\"190\" /></a></div>"
}
