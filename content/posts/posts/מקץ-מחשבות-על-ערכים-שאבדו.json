  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">אֲנָשִׁים דַּלִּים<br /></span><span style=\"font-family: arial;\">שׁוֹחֲטִים<br /></span><span style=\"font-family: arial;\">פָּרוֹת קְדוֹשׁוֹת</span></p><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">אִישִׁים רֵיקִים<br /></span><span style=\"font-family: arial;\">זוֹבְחִים<br /></span><span style=\"font-family: arial;\">פָּרוֹת מְלֵאוֹת</span></p><p data-end=\"526\" data-start=\"512\"><span style=\"font-family: arial;\">בְּנֵי אָדָם רָעִים<br /></span><span style=\"font-family: arial;\">טוֹבְחִים<br /></span><span style=\"font-family: arial;\">נְשָׁמוֹת יָפוֹת</span></p></div><div class=\"separator\" style=\"clear: both;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">אַל תַּחְפֹּשׂ פָּרוֹת קְדוֹשׁוֹת לִשְׁחוֹט.<br /></span><span style=\"font-family: arial;\">חַפֵּשׂ מַשֶּׁהוּ קָדוֹשׁ לְשַׁמֵּר.</span></p></div><div class=\"separator\" style=\"clear: both;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><div><span style=\"font-family: arial;\">כְּשֶׁכֻּלָּם מִתְחַזִּים לִקְדוֹשִׁים - הָאֱמוּנָה הַפְּשׁוּטָה נִרְאֵית כְּפֶלֶא.</span></div><div><span style=\"font-family: arial;\"><br /></span></div></span><div><span><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2></span></span><p><span style=\"font-family: arial;\">\"שבע הפרות\" = 1063 = \"נח איש&nbsp;צַדִּיק תָּמִים\"</span></p></div><div><span><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"></span></p></span><ol><li><span style=\"font-family: arial;\">'<b>קֵּץ</b>' / '<b>סּוֹף</b>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖ קצה, אחרי, סיום - סוף</span></span>.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>בְרִיאֹת</b>' / '<b>פַטִּימָן</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖</span></span>&nbsp;מלאות, שמנות - מפוטמות.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>דַּקּוֹת</b>' / '<b>לָקְיָן</b>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖</span></span>&nbsp;ריקות, רזות - לקויות.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>חֲטָאַי</b>' / '<b>סֻרְחָנִי</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖</span></span>&nbsp;מעשים רעים, מבישים - סרוחים</span><span style=\"background-color: white;\">.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>וַיְגַלַּח</b>' / '<b>וְסַפַּר</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖</span></span>&nbsp;גילוח, קיצוץ - תספורת.</span></span></span></li></ol><span><h2 style=\"font-family: Arial, sans-serif;\">👁️ מבט חד<br /></h2></span></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"/assets/images/content/57433a265763a8ba61.png\" style=\"clear: right; float: right; margin-bottom: 1em; margin-right: 1em;\"><img alt=\"פרה רזה מאוד מצולמת בשדה, ובמסך הטלפון מוצג פילטר אינסטגרם ההופך אותה לשמנה ומבריקה\" border=\"0\" data-original-height=\"1536\" data-original-width=\"1024\" height=\"200\" src=\"/assets/images/content/57433a265763a8ba61.png\" width=\"133\" /></a></div><br /></div><div class=\"separator\" style=\"clear: both;\"><span><div><span style=\"font-family: arial;\">&nbsp; &nbsp; בלי פילטרים</span></div></span></div>"
}
