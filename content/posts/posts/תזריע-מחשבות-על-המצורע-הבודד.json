  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p><span style=\"font-family: arial;\">אֲחָדִים הִבְדַּלְתָּ?<br /></span><span style=\"font-family: arial;\">- בְּדִידוּת תֶּחֱוֶה</span></p><p><span style=\"font-family: arial;\">קְשָׁרִים פָּרַמְתָּ?<br /></span><span style=\"font-family: arial;\">- לְבַד תִּשְׁהֶה</span></p><p><span style=\"font-family: arial;\">קְרוֹבִים רִחַקְתָּ?<br /></span><span style=\"font-family: arial;\">- תּוֹהֶה תִּהְיֶה</span></p></div><div class=\"separator\" style=\"clear: both;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><div class=\"separator\" style=\"clear: both;\"><p style=\"clear: both; text-align: right;\"><span style=\"font-family: arial;\">אִם לֹא תַּעֲצֹר לִפְנֵי מִלָּה חַדָּה<br /></span><span style=\"font-family: arial;\">אִם לֹא תַּחֲשֹׁב לִפְנֵי תֵּבָה רָעָה</span></p><p style=\"clear: both; text-align: right;\"><span style=\"font-family: arial;\">- תִּמְצָא אֶת עַצְמְךָ מְדַבֵּר עִם עַצְמְךָ</span></p></div></div><div class=\"separator\" style=\"clear: both;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">שְׁתִיקָה קְטַנָּה מוֹנַעַת בְּדִידוּת גְּדוֹלָה</span></p></span><div><h2><span><span><span style=\"background-color: #fff2cc; font-family: arial; font-size: large;\">💎 פנינה</span></span></span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">\"מִחוּץ לַמַּחֲנֶה מוֹשָׁבוֹ\" = 631 = \"וְלֹא יִפְתַּח פִּיו\"</span></p></div><div><span><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span><b style=\"font-family: arial;\">&nbsp;</b></p><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"></span></p></span><ol><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">בָּדָד</b>' / '<b style=\"background-color: white;\">בִּלְחוֹדוֹהִי</b>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖ לבד - לחוד</span></li><li><span style=\"font-family: arial;\">'<b>לָבָן</b>' / '<b>מִחְוַר</b>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;לבן - חיוור</span></li><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">שָׁפָל</b>' / '<b style=\"background-color: white;\">מַכִּיךְ</b>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;נמוך, מושפל - מך</span></li><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">כֵהָה</b>' / '<b style=\"background-color: white;\">עָמְיָא</b>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;לא חד, לא בהיר - מעומעם</span></li><li><span style=\"font-family: arial;\">'<b style=\"background-color: white;\">בְּגָדָיו</b>' / '<b style=\"background-color: white;\">לְבוּשׁוֹהִי</b>'</span><br /><span style=\"background-color: white; font-family: arial;\">❖</span><span style=\"background-color: white; font-family: arial;\">&nbsp;בגד - לבוש</span></li></ol><span style=\"font-family: arial;\"></span><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">👁️ מבט חד</span><br /></h2><div class=\"separator\" style=\"clear: both;\"><a href=\"/assets/images/content/759b3509a6aece1b38.png\" imageanchor=\"1\" style=\"margin-left: 1em; margin-right: 1em;\"><img alt=\"רישום סמלי של אדם יושב לבדו עם בועת דיבור ריקה\" border=\"0\" data-original-height=\"1536\" data-original-width=\"1024\" height=\"200\" src=\"/assets/images/content/759b3509a6aece1b38.png\" width=\"133\" /></a></div></span><br /></div></div>"
