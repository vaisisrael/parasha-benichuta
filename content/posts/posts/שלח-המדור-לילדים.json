  "content_html": "<p>&nbsp;<span style=\"text-align: center;\">&nbsp; &nbsp;&nbsp;</span><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiUpbStNP-TxUBUP6xQTwKo10gJoMMF9x2EexFx37Qnbeg2mrbcXCAdURGifEkjS-IM1oM01w4bfqt9aukMGZ1-kkNqdObrworXibAH9SVs6X0dcfyAGSXQndplhg6pknRax8zHd5iTf56BPaNaXmTvEIx7WOkAsypjjxB83Tm1LCvfVFYpypPYd_F4XYo/s291/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" style=\"margin-left: 1em; margin-right: 1em; text-align: center;\"><img alt=\"רישום של ילד עם כובע מצחייה\" border=\"0\" data-original-height=\"291\" data-original-width=\"219\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiUpbStNP-TxUBUP6xQTwKo10gJoMMF9x2EexFx37Qnbeg2mrbcXCAdURGifEkjS-IM1oM01w4bfqt9aukMGZ1-kkNqdObrworXibAH9SVs6X0dcfyAGSXQndplhg6pknRax8zHd5iTf56BPaNaXmTvEIx7WOkAsypjjxB83Tm1LCvfVFYpypPYd_F4XYo/s16000/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" /></a></p><h2><span style=\"font-size: large;\"><span><span style=\"font-family: arial;\">🎈&nbsp;</span><span data-end=\"108\" data-start=\"73\" style=\"font-family: arial;\">שיחה בציורים -&nbsp;</span></span><span style=\"font-family: arial;\">עֵינַיִם רוֹאוֹת וְלֵב מְפָרֵשׁ</span></span></h2><p></p><div><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🍇 <b>הַמְּרַגֵּל מֵרְאוּבֵן&nbsp;</b>(בְּהִתְפַּעֲלוּת):<br /></span><span style=\"font-family: arial;\">רָאִינוּ אֶשְׁכּוֹלוֹת&nbsp;גְּדוֹלִים מְאֹד!<br /></span><span style=\"font-family: arial;\">אֲבָל אִם הַפֵּרוֹת כָּל כָּךְ גְּדוֹלִים -<br /></span><span style=\"font-family: arial;\">אֲזַי גַּם הָאֲנָשִׁים מַפְחִידִים.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🏰 <b>הַמְּרַגֵּל מִשִּׁמְעוֹן&nbsp;</b>(בְּפַחַד):<br /></span><span style=\"font-family: arial;\">הֶעָרִים מְבֻצָּרוֹת וְעֲנָקִיּוֹת!<br /></span><span style=\"font-family: arial;\">אֵיךְ נִכָּנֵס?</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👣 <b>הַמְּרַגֵּל מִיִשָּׂשכָר&nbsp;</b>(בְּדַאֲגָה):<br /></span><span style=\"font-family: arial;\">רָאִינוּ אֲנָשִׁים גְּדוֹלִים.<br /></span><span style=\"font-family: arial;\">הֶרְגַּשְׁנוּ קְטַנִּים מְאֹד.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🌪️ </span><b style=\"font-family: arial;\">הַמְּרַגֵּל&nbsp;</b><b style=\"font-family: arial;\">מִבִּנְיָמִין</b><b style=\"font-family: arial;\">&nbsp;</b><span style=\"font-family: arial;\">(בַּחֲרָדָה):<br /></span><span style=\"font-family: arial;\">הָאָרֶץ נִרְאֵית מְסֻכֶּנֶת.<br /></span><span style=\"font-family: arial;\">מִי יוֹדֵעַ מָה יִקְרֶה?</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🧱 <b>הַמְּרַגֵּל&nbsp;</b></span><b style=\"font-family: arial;\">מֵזְבוּלֻן&nbsp;</b><span style=\"font-family: arial;\">(בְּרַעַד):<br /></span><span style=\"font-family: arial;\">הֶעָרִים גְּבוֹהוֹת מִדַּי.<br /></span><span style=\"font-family: arial;\">אֲנַחְנוּ לֹא נַצְלִיחַ.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👀 <b>הַמְּרַגֵּל&nbsp;</b></span><b style=\"font-family: arial;\">מִמְּנַשֶּׁה</b><b style=\"font-family: arial;\">&nbsp;</b><span style=\"font-family: arial;\">(בְּבִלְבּוּל):<br /></span><span style=\"font-family: arial;\">רָאִינוּ </span><span style=\"font-family: arial;\">גִּבּוֹרִים&nbsp;וַעֲנָקִים.<br /></span><span style=\"font-family: arial;\">זֶה מַפְחִיד.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">💔 <b>הַמְּרַגֵּל מֵאָשֵׁר&nbsp;</b>(בְּחֹסֶר בִּטָּחוֹן):<br /></span><span style=\"font-family: arial;\">הָאָרֶץ יָפָה…<br /></span><span style=\"font-family: arial;\">אֲבָל הָעָם שָׁם חָזָק.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-family: arial; font-size: medium;\">🗿<b>הַמְּרַגֵּל מִדָּן</b> (בְּפַחַד):<br />הָעֲנָקִים הֵם הֲכִי מַפְחִידִים.</span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🧭 </span><b style=\"font-family: arial;\">הַמְּרַגֵּל&nbsp;</b><b style=\"font-family: arial;\">מִנַּפְתָּלִי</b><b style=\"font-family: arial;\">&nbsp;</b><span style=\"font-family: arial;\">(עוֹשֶׂה חֶשְׁבּוֹן):<br /></span><span style=\"font-family: arial;\">אֲנַחְנוּ מְעַטִּים.<br /></span><span style=\"font-family: arial;\">הֵם רַבִּים.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🌩️ <b>הַמְּרַגֵּל&nbsp;</b></span><span style=\"font-family: arial;\"><b>מִגָּד</b></span><b style=\"font-family: arial;\">&nbsp;</b><span style=\"font-family: arial;\">(בְּפַחַד גָּדוֹל):<br /></span><span style=\"font-family: arial;\">אֲנִי רוֹאֶה סַכָּנוֹת.<br /></span><span style=\"font-family: arial;\">הַצִּילוּווווו</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👍</span><span style=\"font-family: arial;\">💚 <b>יְהוֹשֻׁעַ -&nbsp;</b></span><span style=\"font-family: arial;\"><b>הַמְּרַגֵּל מֵאֶפְרַיִם&nbsp;</b></span><span style=\"font-family: arial;\">(בְּלֵב טוֹב):<br /></span><span style=\"font-family: arial;\">הָאָרֶץ טוֹבָה מְאֹד מְאֹד.<br /></span><span style=\"font-family: arial;\">אִם ה' אִתָּנוּ - נַצְלִיחַ.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👍</span><span style=\"font-family: arial;\">🦁 <b>כָּלֵב -&nbsp;</b></span><span style=\"font-family: arial;\"><b>הַמְּרַגֵּל מִיְּהוּדָה&nbsp;</b></span><span style=\"font-family: arial;\">(בְּאוֹמֶץ):<br /></span><span style=\"font-family: arial;\">נַעֲלֶה!<br /></span><span style=\"font-family: arial;\">אֲנַחְנוּ יְכוֹלִים.</span></span></p><p data-end=\"242\" data-start=\"158\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">✨ <b>וְהָאֱמֶת אוֹמֶרֶת</b>:<br /></span><span style=\"font-family: arial;\">שְׁתֵּי עֵינַיִם רוֹאוֹת אוֹתוֹ דָּבָר -<br /></span><span style=\"font-family: arial;\">אֲבָל לֵב אַחֵר רוֹאֶה עוֹלָם אַחֵר...</span></span></p></div><div><h2><span style=\"font-family: arial; font-size: large;\">תפזורת מרגלים</span></h2></div><div><span style=\"background-color: white;\"><span style=\"font-family: arial; font-size: medium;\"><span><span>מצאו את&nbsp;</span><strong style=\"font-weight: bold;\">🔍</strong><span>&nbsp;המרגלים: שַׁמּוּעַ, שָׁפָט, כָּלֵב, יִגְאָל, הוֹשֵׁעַ, פַּלְטִי, גַּדִּיאֵל, גַּדִּי, נַחְבִּי, גְּאוּאֵל</span></span></span></span></div><div><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">בכיוונים&nbsp;</span><span style=\"font-family: arial;\">⬅️ ➡️ ⬇️ ⬆️</span></span><br /><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj7Dg7rN-YAYlKaEQZExEkJYpl_hvIZ6FqM5h2Emfzop0j9MgQxxV9HMCQFOi0yZqeamBa4C7jV0fLEqpFSfO_QxoxkNfHtDTONKrFuty-C5i3mo-qSGx-R2XT80ZisbwYFuineJ2ruwsiaZaj0tdLACPb3K_vmxyavg1uXkL7LEmWizYSClGXWeGWZXOs/s465/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\"><img border=\"0\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEj7Dg7rN-YAYlKaEQZExEkJYpl_hvIZ6FqM5h2Emfzop0j9MgQxxV9HMCQFOi0yZqeamBa4C7jV0fLEqpFSfO_QxoxkNfHtDTONKrFuty-C5i3mo-qSGx-R2XT80ZisbwYFuineJ2ruwsiaZaj0tdLACPb3K_vmxyavg1uXkL7LEmWizYSClGXWeGWZXOs/s320/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.PNG\" /></a><br /><h2 style=\"text-align: right;\"><span style=\"font-family: arial;\">נכון או לא בפרשה?</span></h2></div><div><ol><li><span style=\"font-family: arial; font-size: medium;\">מֹשֶׁה שָׁלַח אֶת הַמְּרַגְּלִים עַל דַּעַת עַצְמוֹ?</span></li><li><span style=\"font-family: arial; font-size: medium;\">הַמְּרַגְּלִים נִשְׁלְחוּ לִבְדֹּק אֶת אֶרֶץ מִצְרַיִם?</span></li><li><span style=\"font-family: arial; font-size: medium;\">כָּל הַמְּרַגְּלִים חָזְרוּ וְדִבְּרוּ טוֹב עַל הָאָרֶץ?</span></li><li><span style=\"font-family: arial; font-size: medium;\">הַמְּרַגְּלִים רָאוּ פֵּרוֹת גְּדוֹלִים?</span></li><li><span style=\"font-family: arial; font-size: medium;\">הַמְּרַגְּלִים פָּחֲדוּ מֵהָאֲנָשִׁים שֶׁגָּרוּ בָּאָרֶץ?</span></li><li><span style=\"font-family: arial; font-size: medium;\">הָעָם הֶאֱמִין לְדִבְרֵי יְהוֹשֻׁעַ וְכָלֵב?</span></li><li><span style=\"font-family: arial; font-size: medium;\">בְּנֵי אוֹתוֹ דּוֹר נֶעֶנְשׁוּ וְלֹא נִכְנְסוּ לָאָרֶץ?</span></li><li><span style=\"font-family: arial; font-size: medium;\">יְהוֹשֻׁעַ וְכֶלֶב זָכוּ לְהִכָּנֵס לָאָרֶץ?</span></li><li><span style=\"font-family: arial; font-size: medium;\">פַּלְטִי בֶּן רָפוּא אָמַר \"טוֹבָה הָאָרֶץ מְאֹד מְאֹד\"?</span></li><li><span style=\"font-family: arial; font-size: medium;\">בַּפָּרָשָׁה מוֹפִיעָה מִצְוַת צִיצִית?</span></li></ol></div>"
}
