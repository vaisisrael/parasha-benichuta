ol style=\"text-align: right;\"><li><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-weight: 400;\">מה פירוש המילה</span><span style=\"font-weight: normal;\"><span style=\"font-family: arial;\">&nbsp;</span><span style=\"font-family: arial;\">פִּילַּלְתִּי</span><span style=\"font-family: arial;\">?</span></span></span></li><ol style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">הופללתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">פלפלתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">התעלפתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">חשבתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">נפלתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">התפלפתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">התפללתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">התנפלתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">התבלבלתי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">גידלתי פלולה</span></span></li></ol><li><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-weight: 400;\">מה זה כִּבְרַת אֶרֶץ</span><span style=\"font-family: arial;\"><span style=\"font-weight: normal;\">?</span></span></span></li><ol style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">שטח בגודל מסוים</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">שטח שמיועד לקבורה</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">שטח עצום וכביר</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">שטח עגול כִּכְבָרָה</span></span></li></ol><li><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-weight: 400;\">איך נקראת 'ארץ מולדת' בפרשה</span><span style=\"font-family: arial;\"><span face=\"Arial, Tahoma, Helvetica, FreeSans, sans-serif\"><span style=\"font-weight: 400;\">?</span></span></span></span></li><ol style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><li><span style=\"font-family: arial; font-size: medium;\">יצוע</span></li><li><span style=\"font-family: arial; font-size: medium;\">שׂוֹרֵקָה</span></li><li><span style=\"font-size: medium;\">כנען</span></li><li><span style=\"font-family: arial; font-size: medium;\">מכורה</span></li></ol><li><span style=\"font-size: medium;\"><span style=\"font-family: arial;\"><span style=\"font-weight: 400;\">מה זה&nbsp;חכלילי?</span></span></span></li><ol style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><li><span style=\"font-family: arial; font-size: medium;\">צבע אדום</span></li><li><span style=\"font-family: arial; font-size: medium;\">חס וחלילה</span></li><li><span style=\"font-family: arial; font-size: medium;\">חג לי</span></li><li><span style=\"font-size: medium;\">סוג של ציפור</span></li></ol><li><span face=\"Arial, Tahoma, Helvetica, FreeSans, sans-serif\" style=\"font-size: medium; font-weight: 400;\"><span style=\"font-family: arial;\">מה זה אטד?</span></span></li><ol style=\"font-weight: 400;\"><li style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif;\"><span style=\"font-family: arial; font-size: medium;\">עתיד רחוק</span></li><li><span style=\"font-family: arial; font-size: medium;\">עתיד קרוב</span></li><li><span style=\"font-family: arial; font-size: medium;\">שיח קוצני</span></li><li><span style=\"font-family: arial; font-size: medium;\">גופה שנחנטה</span>&nbsp;</li></ol></ol></div></h3><h2 style=\"text-align: center;\"><span style=\"background-color: white; font-family: arial;\"><span style=\"font-size: large;\">מדרגאות</span></span></h2><h3 style=\"background-color: white; margin: 1em 0px; text-align: center;\"><div style=\"text-align: start;\"><p style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲 לא מת<br /></span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲 כיסוי לקיר<br /></span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲 מַכֶּה/זורק ופוגע<br /></span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; white-space-collapse: preserve;\">🔲 גופות משומרים (מהפרשה-כתיב חסר)\n</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲 מאכל שבתי\n</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲 לא נייד (כתיב חסר)\n</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲</span><span style=\"font-family: arial; text-decoration-line: inherit; white-space-collapse: preserve;\">🔲 נוי</span></span></p></div></h3><h2 style=\"margin: 1em 0px; text-align: center;\"><span style=\"font-family: arial;\"><span style=\"font-size: large;\">פתרונות</span></span></h2><h3 style=\"margin: 1em 0px; text-align: center;\"><div style=\"text-align: start;\"><h3 style=\"background-color: white; font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; text-align: right;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-variant-ligatures: none; text-decoration-line: inherit;\">תמונה טמונה</span></span></h3><p style=\"background-color: white; font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400; text-align: right;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">'בית לחם'</span></p><div style=\"background-color: white; font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\"><h3 style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 18.72px; font-variant-ligatures: normal; text-align: right;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-variant-ligatures: none; text-decoration-line: inherit;\">מי אני</span></span></h3><p style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 18.72px; font-variant-ligatures: normal; text-align: right;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">אביגדור קהלני (שר, בעל עיטור הגבורה)<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">זאב ז'בוטינסקי (מנהיג, ראש 'ביתר')<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">יגאל ידין (רמטכ\"ל)<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">איתן בן אליהו (אלוף)</span></p><div style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 18.72px; font-variant-ligatures: normal;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\"></span></div></span></div><div style=\"background-color: white; font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-weight: 400;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\"><h3 style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-variant-ligatures: normal; text-align: right;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">מבחן אמריקאי</span></h3><p style=\"font-family: Arial, Tahoma, Helvetica, FreeSans, sans-serif; font-size: 18.72px; font-variant-ligatures: normal; text-align: right;\"><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">שאלה 1 תשובה 4<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">שאלה 2 תשובה 1<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">שאלה 3 תשובה 4<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">שאלה 4 תשובה 1<br /></span><span style=\"font-family: arial; font-size: medium; font-variant-ligatures: none; text-decoration-line: inherit;\">שאלה 5 תשובה 3</span></p><h3 style=\"text-align: right;\"><span style=\"font-family: arial; font-size: medium; text-decoration-line: inherit;\">מדרגאות</span></h3></span></div><div><span class=\"KB0Tx C9DxTc\" style=\"font-size: medium;\"><div><span style=\"background-color: white; font-family: arial; font-variant-ligatures: none; font-weight: 400; text-decoration-line: inherit;\">חי, טיח, מטיח,</span><span style=\"font-family: arial; font-weight: normal;\">&nbsp;חֲנֻטִים,</span><span style=\"background-color: white; font-family: arial; font-variant-ligatures: none; font-weight: 400; text-decoration-line: inherit;\">&nbsp;חמין, ניח, חן</span></div></span></div></div></h3>"
