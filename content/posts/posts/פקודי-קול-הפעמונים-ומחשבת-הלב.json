  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p style=\"clear: both;\"><span style=\"font-family: arial;\">וּבַמְּעִיל,<br /></span><span style=\"font-family: arial;\">פַּעֲמוֹן וְרִמּוֹן.<br /></span><span style=\"font-family: arial;\">וְגִיל,<br /></span><span style=\"font-family: arial;\">וְהִתְפַּעֲמוּת וְרוֹן.</span></p><p style=\"clear: both;\"><span style=\"font-family: arial;\">וּבְשַׁעַר הָאִיתוֹן,<br /></span><span style=\"font-family: arial;\">מְדַנְדֵּן הַצְּלִיל.<br /></span><span style=\"font-family: arial;\">עַל רֹעַ לָשׁוֹן,<br /></span><span style=\"font-family: arial;\">לְכַפֵּר כָּלִיל.</span></p></div><div class=\"separator\" style=\"clear: both;\"><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><span style=\"font-family: arial;\"><p style=\"clear: both; text-align: right;\">אַל תְּדַבֵּר מִתּוֹךְ דַּחַף רִגְעִי, כַּעַס אוֹ עֲכִירוּת.<br />קַח רֶגַע \"לְסַנֵּן\" אֶת הַמַּחְשָׁבָה - וְאָז הַמִּלָּה הוֹפֶכֶת לִצְלִיל נָקִי, כְּמוֹ פַּעֲמוֹן הַמְּעִיל.</p></span></div><div class=\"separator\" style=\"clear: both;\"><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><div><div><span style=\"font-family: arial;\">כְּשֶׁהַדִּבּוּר מְזֻכָּךְ - הַצְּלִיל נִצְרַף</span><span style=\"font-family: arial;\">.</span></div></div><div><span style=\"font-family: arial;\"><br /></span></div></span><div><span><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2></span></span><span style=\"font-family: arial;\"><span data-end=\"1216\" data-start=\"1146\">\"פַּעֲמֹן וְרִמֹּן פַּעֲמֹן וְרִמֹּן עַל שׁוּלֵי הַמְּעִיל סָבִיב\"</span><br data-end=\"1219\" data-start=\"1216\" />\n<em data-end=\"1243\" data-start=\"1219\">המעיל מכפר על לשון הרע</em> (זבחים פח:)<br data-end=\"1258\" data-start=\"1255\" />\n<span data-end=\"1314\" data-start=\"1258\">פַּעֲמֹן וְרִמֹּן = 536 = \"וְאָהַבְתָּ לוֹ כָּמוֹךָ\"</span> (ויקרא י\"ט ל\"ד)<br /></span><p><br /></p></div><div><span><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span></p></span><span><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; color: #626262; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p><span style=\"background-color: white; color: #202122; font-family: arial; text-align: -webkit-center;\"></span></p></span><ol><li><span style=\"font-family: arial;\">'<b>פְקוּדֵי</b>' / '<b>מִנְיָנֵי</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖ תוצאות של מִפְקָד, ספירה - מניין</span></span>.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>שׁוּלֵי</b>' / '<b>שִׁפּוֹלֵי</b>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;החלק התחתון: שולי הבגד - שיפולי ההר.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>וְצִפָּה</b>' / '<b>וְחַפִּי</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;ציפוי, כיסוי - חיפוי.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>וְחִשַּׁק</b>' / '<b>וְכַבֵּישׁ</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;קשירה, הידוק - כבישה</span><span style=\"background-color: white;\">.</span></span></span></li><li><span style=\"font-family: arial;\">'<b>פַּחֵי</b>' / '<b>טַסֵי</b>'<br /></span><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\"><span style=\"font-family: arial;\"><span>❖</span></span>&nbsp;דף מתכת דק - טס.</span></span></span></li></ol><span><h2 style=\"font-family: Arial, sans-serif;\">👁️ מבט חד</h2><div class=\"separator\" style=\"clear: both; text-align: right;\"><a href=\"/assets/images/content/62ba5bfe6f10bf6b66.png\" style=\"margin-left: 1em; margin-right: 1em;\"><img alt=\"ChatGPT said:  ALT: איור מינימליסטי של פעמון מוזהב המשמיע צליל, ולצדו שלוש בועות דיבור שחורות\" border=\"0\" data-original-height=\"1024\" data-original-width=\"1024\" height=\"200\" src=\"/assets/images/content/62ba5bfe6f10bf6b66.png\" width=\"200\" /></a></div><br /><div><br /></div></span></div><div class=\"separator\" style=\"clear: both; text-align: center;\"><div><br /></div></div></div>"
}
