  "content_html": "<p style=\"text-align: center;\">&nbsp;<span style=\"text-align: center;\">&nbsp;</span><img border=\"0\" src=\"/assets/images/content/418f56abc640a0f997.png\" style=\"text-align: center;\" /></p><div class=\"separator\" style=\"clear: both;\"><h2 style=\"text-align: right;\"><span style=\"background-color: #fff2cc; font-family: arial;\">🕯️ מעט מן האור</span></h2><p style=\"text-align: right;\"><span style=\"font-family: arial;\">בְּשַׁבְּתוֹתֵיכֶם,<br /></span><span style=\"font-family: arial;\">לֹא תַּבְעִירוּ אֵשׁ:<br /></span><span style=\"font-family: arial;\">- חוֹלֶקֶת<br /></span><span style=\"font-family: arial;\">- צוֹלֶבֶת<br /></span><span style=\"font-family: arial;\">- אוֹכֶלֶת</span></p><p style=\"text-align: right;\"><span style=\"font-family: arial;\">בְּמֹשְׁבֹתֵיכֶם,<br /></span><span style=\"font-family: arial;\">לֹא תַּצִּיתוּ אֵשׁ:<br /></span><span style=\"font-family: arial;\">- תָּפְתָּהּ<br /></span><span style=\"font-family: arial;\">- זָרָה<br /></span><span style=\"font-family: arial;\">- אֹכְלָה</span></p><h2 style=\"font-family: Arial, sans-serif; text-align: right;\"><span style=\"background-color: #fff2cc;\">📘 עצה שבועית</span></h2><p></p><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">שַׁבָּת מְבַקֶּשֶׁת: אַל תַּדְלִיק אֵשׁ בֵּין אֲנָשִׁים.</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">דַּי בְּרִסּוּן קָטָן לִפְנֵי מִלָּה חַדָּה,</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">דַּי בְּחִיּוּךְ אֶחָד שֶׁמְּקַבֵּל אֶת הָאַחֵר כְּמוֹ שֶׁהוּא,</span></div><div class=\"separator\" style=\"clear: both;\"><span style=\"font-family: arial;\">כְּדֵי לַהֲפֹךְ אֶת הַשֻּׁלְחָן לְמָקוֹם שֶׁל נַחַת.</span></div><p></p><h2 style=\"font-family: Arial, sans-serif; text-align: right;\"><span style=\"background-color: #fff2cc;\">🌀 הצד השני של המטבע</span></h2><p style=\"text-align: right;\"><span style=\"background-color: #fff2cc; font-family: arial;\"></span></p><div style=\"text-align: right;\"><div><span style=\"font-family: arial;\">כְּשֶׁאֵשׁ הַכַּעַס בּוֹעֶרֶת - הַשֻּׁלְחָן מִתְקָרֵר-מִתְקַדֵּר</span><span style=\"font-family: arial;\">;</span></div><div><span style=\"font-family: arial;\">וּכְשֶׁאוֹסְפִים אֶת הַלֶּהָבָה - הַחֹם הַמִּשְׁפַּחְתִּי חוֹזֵר.</span></div></div><div style=\"text-align: right;\"><span style=\"font-family: arial;\"><br /></span></div><div><span><h2 style=\"font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\">💎 פנינה</span></h2><p><span style=\"font-family: arial;\"><span face=\"Arial, sans-serif\">\"לֹא תְבַעֲרוּ\" = 709 = \"וְנִזְכֶּה כֻלָּנוּ יַחַד מְהֵרָה לְאוֹרוֹ\" (מתוך ברכת \"יוצר אור\")</span></span></p><h2 style=\"background: 0px 0px rgb(255, 255, 255); border: 0px; box-sizing: border-box; font-family: Arial, sans-serif; font-size: 23px; line-height: 1.3em; margin: 0px 0px 20px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px rgb(255, 242, 204); border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">📘 מילון ארמי־עברי</span></h2><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"><span style=\"background: 0px 0px; border: 0px; box-sizing: border-box; font-family: arial; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\"><i style=\"background: 0px 0px; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">חמש מילים מארמית שבתורה - עם פענוח והארה לשונית.</i></span></p></span></div><div><span><p style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; font-size: 15px; margin: 0px 0px 25px; outline: none; padding: 0px; vertical-align: baseline;\"></p><p style=\"font-family: arial;\"><span face=\"Arial, sans-serif\"></span></p></span><ol style=\"box-sizing: border-box; counter-reset: templateify 0; margin: 10px 0px; padding: 0px 20px 0px 0px;\"><li><span style=\"font-family: arial;\">'<b>מְאָדָּמִים</b>' / '<b>מְסֻמְּקֵי</b>'</span><br /><span><span style=\"font-family: arial;\"><span style=\"background-color: white;\">❖ מאדים - מסמיק</span></span></span></li><li><span style=\"font-family: arial;\">'<b>אֲדָנִים</b>' / '<b>סָמְכִין</b>'<br /><span><span><span style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span style=\"background-color: white;\">&nbsp;בסיסים שעליהם נסמכים</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b>חָכְמָה</b>' / '<b>סֻכְלְתָנוּ</b>'<br /><span><span><span style=\"background-color: white;\">❖ שכל - השכלה</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b>וַיַּעֲבִירוּ קוֹל</b>' / '<b>וְאַעְבַּרוּ כָּרוֹז</b>'<br /><span><span><span style=\"background: 0px 0px white; border: 0px; box-sizing: border-box; margin: 0px; outline: none; padding: 0px; vertical-align: baseline;\">❖</span><span style=\"background-color: white;\">&nbsp;הודעה - הכרזה</span></span></span></span></li><li><span style=\"font-family: arial;\">'<b>מַקְבִּילֹת</b>' / '<b>מַכְוְנָן</b>'<br /><span><span><span style=\"background-color: white;\">❖ זו מול זו בדיוק</span></span></span></span></li></ol><span><div style=\"font-family: arial;\"><br /></div><h2 style=\"display: inline; font-family: Arial, sans-serif;\"><span style=\"background-color: #fff2cc;\"><div><span style=\"font-family: arial;\"></span></div>👁️ מבט חד</span></h2></span></div><div><table align=\"center\" cellpadding=\"0\" cellspacing=\"0\" class=\"tr-caption-container\" style=\"float: right; margin-left: 1em; text-align: right;\"><tbody><tr><td style=\"text-align: center;\"><a href=\"/assets/images/content/c2d5c857a991297454.png\" style=\"margin-left: auto; margin-right: auto;\"><img border=\"0\" src=\"/assets/images/content/c2d5c857a991297454.png\" /></a></td></tr><tr><td class=\"tr-caption\" style=\"text-align: center;\"><span style=\"font-family: arial;\">מניחים את הטלפון<br />ומשאירים את האש בחוץ</span></td></tr></tbody></table><br /><br /><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"/assets/images/content/47d1d22f005747a401.png\" style=\"clear: right; display: inline; float: right; margin-bottom: 1em; margin-left: 1em;\"><br /></a></div></div></div>"
}
