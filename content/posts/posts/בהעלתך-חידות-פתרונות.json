  "content_html": "<p>&nbsp;<span style=\"text-align: center;\">&nbsp;</span></p><div class=\"separator\" style=\"clear: both; text-align: center;\"><a href=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiqA-FI4_t-vQuwfvBNQUW8FNHQK2hdvXH2d5r9XSUvThZVVNfxVaMxNvRWtpgFUdGAtfkquqoF9TJDDE8B0y7fdbZg9nDU3I3P7X5rA4zkKnD2CrLruoJy7pBfpyk_xylBaReA0AygnLsgp7QzTlRBwI4opdLYazhjbXjHc18SLpiAa_pPD9Zhf7W0jPg/s598/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.GIF\" style=\"margin-left: 1em; margin-right: 1em;\"><img alt=\"שמות בכתב קפצ'ה\" border=\"0\" data-original-height=\"197\" data-original-width=\"598\" height=\"131\" src=\"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiqA-FI4_t-vQuwfvBNQUW8FNHQK2hdvXH2d5r9XSUvThZVVNfxVaMxNvRWtpgFUdGAtfkquqoF9TJDDE8B0y7fdbZg9nDU3I3P7X5rA4zkKnD2CrLruoJy7pBfpyk_xylBaReA0AygnLsgp7QzTlRBwI4opdLYazhjbXjHc18SLpiAa_pPD9Zhf7W0jPg/w400-h131/%E2%80%8F%E2%80%8F%D7%9C%D7%9B%D7%99%D7%93%D7%94.GIF\" width=\"400\" /></a></div><br /><p></p><p></p><p></p><div><div><h2 style=\"text-align: center;\"><span style=\"font-family: arial; font-size: large;\">מה בקפצ'ה</span></h2><div style=\"text-align: right;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial; font-weight: normal;\">ארבעה שמות המוזכרים בפרשה, חבויים בקפצ'ה (</span><span face=\"sans-serif\" style=\"background-color: #f8f9fa; color: #202122; font-weight: normal;\">CAPTCHA</span><span style=\"font-family: arial; font-weight: normal;\">) שבתמונת הכותרת. גלו אותם.</span></span></div><h2 style=\"text-align: center;\"><span style=\"font-family: arial; font-size: large;\">מכנה משותף</span></h2></div><p><span style=\"font-family: arial; font-size: medium;\">לפניכם צמדי מילים שאין ביניהם קשר.<br /></span><span style=\"font-family: arial; font-size: medium;\">אבל, יש להן מכנה משותף - באמצעות מילה שלישית, המתחברת לכל אחת מהן.</span></p><p><span style=\"font-family: arial; font-size: medium;\">👈דוגמה:</span></p><p><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 חולים<br /></span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 צדקה<br /></span><span style=\"font-family: arial;\">המילה המשותפת - בעלת 4 אותיות - הנה 'קופת'.</span></span></p><p><span style=\"font-family: arial; font-size: medium;\">👈בונוס:&nbsp;</span></p><div><span style=\"font-family: arial; font-size: medium;\">המילה 'השלישית' (המחברת) בכל צמד - מוזכרת בפרשה.</span></div><p><span style=\"font-family: arial; font-size: medium;\"><u><b>צמד 1:</b></u></span></p><p><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 חטאת<br /></span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 גשם</span></span></p><p><span style=\"font-family: arial; font-size: medium;\"><u><b>צמד 2:</b></u></span></p><p><span style=\"font-family: arial; font-size: medium;\"></span></p><div style=\"font-family: &quot;Times New Roman&quot;;\"></div><p></p><p style=\"orphans: 2; text-align: right; text-decoration-color: initial; text-decoration-style: initial; text-decoration-thickness: initial; text-indent: 0px; widows: 2;\"><span style=\"font-size: medium;\"><span style=\"-webkit-text-stroke-width: 0px; color: black; font-family: arial; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; text-transform: none; white-space: normal; word-spacing: 0px;\">🔲</span><span style=\"-webkit-text-stroke-width: 0px; color: black; font-family: arial; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; text-transform: none; white-space: normal; word-spacing: 0px;\">🔲</span><span style=\"font-family: arial;\">🔲 הָעַרְבַּיִם</span><br /><span style=\"-webkit-text-stroke-width: 0px; color: black; font-family: arial; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; text-transform: none; white-space: normal; word-spacing: 0px;\">🔲</span><span style=\"-webkit-text-stroke-width: 0px; color: black; font-family: arial; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; text-transform: none; white-space: normal; word-spacing: 0px;\">🔲</span><span style=\"-webkit-text-stroke-width: 0px; color: black; font-family: arial; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; text-transform: none; white-space: normal; word-spacing: 0px;\">🔲&nbsp;</span><span style=\"font-family: arial;\">הַמְּצָרִים</span></span></p><p><span style=\"font-family: arial; font-size: medium;\"><u><b>צמד 3:</b></u></span></p><p><span style=\"font-family: arial; font-size: medium;\"></span></p><div></div><p></p><p></p><div></div><p></p><p style=\"-webkit-text-stroke-width: 0px; font-family: &quot;Times New Roman&quot;; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration-color: initial; text-decoration-style: initial; text-decoration-thickness: initial; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">שְׁלֹשֶׁת 🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲<br /></span><span style=\"font-family: arial;\">🔲🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 ולילות</span></span></p><p><span style=\"font-family: arial; font-size: medium;\"><u><b>צמד 4:</b></u></span></p><p><span style=\"font-family: arial; font-size: medium;\"></span></p><div></div><p></p><p></p><div></div><p></p><p></p><div></div><p></p><p style=\"-webkit-text-stroke-width: 0px; font-family: &quot;Times New Roman&quot;; font-style: normal; font-variant-caps: normal; font-variant-ligatures: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: right; text-decoration-color: initial; text-decoration-style: initial; text-decoration-thickness: initial; text-indent: 0px; text-transform: none; white-space: normal; widows: 2; word-spacing: 0px;\"><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">לְשַׁד 🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲<br /></span><span style=\"font-family: arial;\">🔲🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 והרזה</span></span></p><p><span style=\"font-family: arial; font-size: medium;\"><u><b>צמד 5:</b></u></span></p><p><span style=\"font-family: arial; font-size: medium;\"></span></p><div></div><p></p><p></p><div></div><p></p><p></p><div></div><p></p><p><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">מכל 🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲<br /></span><span style=\"font-family: arial;\">🔲🔲</span><span style=\"font-family: arial;\">🔲</span><span style=\"font-family: arial;\">🔲 הקדמון</span></span></p><div><h2 style=\"text-align: center;\"><span style=\"font-family: arial; font-size: large;\">פתגמים פגומים</span></h2><p><span style=\"background-color: white; font-family: arial; font-size: medium;\">גלו את הפתגמים והביטויים המופיעים בפרשה</span></p><p><span style=\"background-color: white; font-family: arial; font-size: medium;\">לדוגמה: הרוע נאצ = רועה צאן.</span></p><p><span style=\"font-family: arial; font-size: medium;\"><span style=\"background-color: white;\"><span>1👈 הפ לא הפ</span></span></span></p><p><span style=\"font-size: medium;\"><span style=\"font-family: arial;\"><span><span style=\"background-color: white;\">2👈&nbsp;</span></span></span><span style=\"font-family: arial;\">שלד הנמש</span></span></p><p></p><p><span style=\"font-family: arial; font-size: medium;\"><span><span style=\"background-color: white;\">3👈 נחת השם&nbsp;</span></span></span></p><p><br /></p></div><h2 style=\"text-align: center;\"><span style=\"font-family: arial;\"><span style=\"font-size: large;\">מדרגאות</span></span></h2></div><div><h3><p style=\"text-align: right;\"><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲 מִכְּלֵי השחמט<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲</span><span>🔲 חָפְצוּ<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲</span><span>🔲</span><span>🔲 אירועים רעים<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲</span><span>🔲</span><span>🔲</span><span>🔲 שם מקום (מהפרשה)&nbsp;<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲</span><span>🔲</span><span>🔲 עיר בגליל<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲</span><span>🔲 חלקו לשני חלקים<br /></span></span><span style=\"font-family: arial; font-size: medium; font-weight: normal;\"><span>🔲</span><span>🔲 נקי</span></span></p></h3><h2 style=\"text-align: center;\"><span style=\"font-family: arial; font-size: large;\">פתרונות</span></h2><div><h3 style=\"text-align: right;\"><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">👈 מה בקפצ'ה:&nbsp;</span></span></h3><p><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">אבידן, אליסף, גמליאל, נפתלי</span></span></p><h3 style=\"text-align: right;\"><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">👈 מכנה משותף:</span></span></h3><span style=\"font-family: arial;\"><ol><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">מי</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">בין</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">ימים</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">השמן</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">האדם</span></span></li></ol></span></div><div><h3><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👈 פתגמים פגומים:</span></span></h3><span style=\"font-family: arial;\"><ol><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">פה אל פה</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">לשד השמן</span></span></li><li><span style=\"font-family: arial;\"><span style=\"font-size: medium;\">חֹתֵן משה</span></span></li></ol></span></div><h3><span style=\"font-size: medium;\"><span style=\"font-family: arial;\">👈&nbsp;</span><span style=\"font-family: arial;\">מדרגאות:</span></span></h3><h3><div></div></h3><span style=\"font-family: arial; font-size: medium;\">רץ, רצו, צרות, חצרות, חצור, חצו, צח</span></div>"
}
