  "output_path": "p/בקצרה.html",
  "parasha_label": null,
  "parasha_name": null,
  "book": null,
  "section": null,
  "series": null,
  "content_html": "<div dir=\"rtl\" id=\"shorts-app\">\n  <div class=\"shorts-shell\">\n    <header class=\"shorts-hero\">\n      <p class=\"shorts-question\" id=\"shorts-question\">מה תרצו לקחת מהפרשה?</p>\n    </header>\n\n    <section class=\"shorts-types\" id=\"shorts-types\"></section>\n\n    <section class=\"shorts-result-wrap\" hidden=\"\" id=\"shorts-result-wrap\">\n      <div class=\"shorts-result-card\">\n        <div class=\"shorts-result-topline\">\n          <div class=\"shorts-current-type\" id=\"shorts-current-type\"></div>\n        </div>\n\n        <div class=\"shorts-content\" id=\"shorts-content\"></div>\n\n        <div class=\"shorts-actions\">\n          <button class=\"shorts-like-btn\" id=\"shorts-like-btn\" type=\"button\">\n            אהבתי <span class=\"shorts-like-count\" id=\"shorts-like-count\">0</span>\n          </button>\n\n          <button class=\"shorts-next-btn\" hidden=\"\" id=\"shorts-next-btn\" type=\"button\">עוד</button>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"shorts-message\" id=\"shorts-message\"></div>\n  </div>\n</div>\n\n<style>\n  #shorts-app {\n    --shorts-bg: #f7f4ee;\n    --shorts-card: #fffdf9;\n    --shorts-border: #e3d9c9;\n    --shorts-text: #2f2a23;\n    --shorts-soft: #7a6e5e;\n    --shorts-shadow: 0 10px 30px rgba(70, 52, 22, 0.08);\n    color: var(--shorts-text);\n    background: linear-gradient(180deg, #faf8f3 0%, var(--shorts-bg) 100%);\n    border: 1px solid #eee3d1;\n    border-radius: 28px;\n    padding: 18px 18px 28px;\n    margin: 18px 0 28px;\n    font-family: inherit;\n  }\n\n  #shorts-app * {\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  #shorts-app .shorts-shell {\n    max-width: 860px;\n    margin: 0 auto;\n  }\n\n  #shorts-app .shorts-hero {\n    text-align: center;\n    margin-bottom: 26px;\n  }\n\n  #shorts-app .shorts-question {\n    margin: 0;\n    font-size: 1.22rem;\n    font-weight: 700;\n    line-height: 1.5;\n  }\n\n  #shorts-app .shorts-types {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px 16px;\n    justify-content: center;\n    margin: 0 auto 30px;\n  }\n\n  #shorts-app .shorts-type-btn {\n    appearance: none;\n    border: 1px solid var(--shorts-border);\n    background: rgba(255, 255, 255, 0.95);\n    color: var(--shorts-text);\n    border-radius: 999px;\n    padding: 12px 18px;\n    font: inherit;\n    cursor: pointer;\n    min-height: 48px;\n    box-shadow: 0 2px 8px rgba(90, 70, 25, 0.04);\n    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n  }\n\n  #shorts-app .shorts-type-btn:hover,\n  #shorts-app .shorts-type-btn:focus-visible {\n    transform: translateY(-1px);\n    box-shadow: 0 8px 20px rgba(90, 70, 25, 0.08);\n    border-color: #ccb27a;\n    outline: none;\n  }\n\n  #shorts-app .shorts-type-btn.is-active {\n    background: #fff5df;\n    border-color: #d5b778;\n  }\n\n  #shorts-app .shorts-type-icon {\n    font-size: 1.08rem;\n    line-height: 1;\n  }\n\n  #shorts-app .shorts-type-text {\n    font-weight: 700;\n  }\n\n  #shorts-app .shorts-result-card {\n    background: var(--shorts-card);\n    border: 1px solid var(--shorts-border);\n    border-radius: 24px;\n    padding: 18px 18px 16px;\n    box-shadow: var(--shorts-shadow);\n  }\n\n  #shorts-app .shorts-result-topline {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 12px;\n    margin-bottom: 10px;\n  }\n\n  #shorts-app .shorts-current-type {\n    font: inherit;\n    font-weight: 700;\n    font-size: 1.06rem;\n    line-height: 1.5;\n    color: #85704c;\n  }\n\n  #shorts-app .shorts-content {\n    font-size: 1.2rem;\n    line-height: 1.95;\n    min-height: 56px;\n  }\n\n  #shorts-app .shorts-actions {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-top: 14px;\n    flex-wrap: wrap;\n  }\n\n  #shorts-app .shorts-like-btn,\n  #shorts-app .shorts-next-btn {\n    appearance: none;\n    border: 1px solid #d9c6a0;\n    background: #fff;\n    color: #4f4128;\n    border-radius: 999px;\n    padding: 10px 16px;\n    font: inherit;\n    cursor: pointer;\n    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;\n  }\n\n  #shorts-app .shorts-like-btn:hover,\n  #shorts-app .shorts-next-btn:hover,\n  #shorts-app .shorts-like-btn:focus-visible,\n  #shorts-app .shorts-next-btn:focus-visible {\n    background: #fff8eb;\n    border-color: #c9a85b;\n    outline: none;\n    transform: translateY(-1px);\n  }\n\n  #shorts-app .shorts-like-btn[disabled] {\n    opacity: 0.65;\n    cursor: wait;\n    transform: none;\n  }\n\n  #shorts-app .shorts-like-count {\n    display: inline-block;\n    margin-inline-start: 4px;\n    color: #8b806f;\n    font-size: 0.96em;\n    font-weight: 500;\n  }\n\n  #shorts-app .shorts-message {\n    text-align: center;\n    color: var(--shorts-soft);\n    margin-top: 16px;\n    min-height: 24px;\n  }\n\n  @media (max-width: 640px) {\n    #shorts-app {\n      padding: 16px 12px 22px;\n      border-radius: 20px;\n    }\n\n    #shorts-app .shorts-question {\n      font-size: 1.08rem;\n      line-height: 1.6;\n      padding-inline: 4px;\n    }\n\n    #shorts-app .shorts-types {\n      gap: 12px;\n      margin-bottom: 24px;\n    }\n\n    #shorts-app .shorts-type-btn {\n      width: 100%;\n      justify-content: center;\n      padding: 12px 16px;\n    }\n\n    #shorts-app .shorts-result-card {\n      padding: 16px 14px 14px;\n      border-radius: 20px;\n    }\n\n    #shorts-app .shorts-current-type {\n      font-size: 1rem;\n    }\n\n    #shorts-app .shorts-content {\n      font-size: 1.08rem;\n      line-height: 1.9;\n      min-height: 48px;\n    }\n\n    #shorts-app .shorts-actions {\n      margin-top: 12px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  const WEB_APP_URL = 'https://script.google.com/macros/s/AKfycbzk_iC7Iph7qCoFhERhUNszUfVB42knXM6PSQ3H1FnRWPaL3l2cmI-z4CCQCVwGOpsHyw/exec';\n\n  const state = {\n    data: null,\n    currentType: null,\n    currentIndexByType: {},\n    currentItem: null,\n    jsonpCounter: 0,\n    activeParashotRaw: '',\n    activeParashotList: []\n  };\n\n  const els = {\n    question: document.getElementById('shorts-question'),\n    types: document.getElementById('shorts-types'),\n    resultWrap: document.getElementById('shorts-result-wrap'),\n    currentType: document.getElementById('shorts-current-type'),\n    content: document.getElementById('shorts-content'),\n    nextBtn: document.getElementById('shorts-next-btn'),\n    likeBtn: document.getElementById('shorts-like-btn'),\n    likeCount: document.getElementById('shorts-like-count'),\n    message: document.getElementById('shorts-message')\n  };\n\n  function setMessage(text) {\n    els.message.textContent = text || '';\n  }\n\n  function escapeHtml(text) {\n    return String(text)\n      .replaceAll('&', '&amp;')\n      .replaceAll('<', '&lt;')\n      .replaceAll('>', '&gt;')\n      .replaceAll('\"', '&quot;')\n      .replaceAll(\"'\", '&#39;');\n  }\n\n  function stripCodePrefix(label) {\n    return String(label || '').replace(/^\\s*\\d+-\\d+\\s+/, '').trim();\n  }\n\n  function parseParashot(raw) {\n    return String(raw || '')\n      .split(';')\n      .map(function (s) { return s.trim(); })\n      .filter(Boolean);\n  }\n\n  function buildQuestionFromParashot(parashot) {\n    if (!parashot || !parashot.length) {\n      return 'מה תרצו לקחת מהפרשה?';\n    }\n\n    if (parashot.length === 1) {\n      const clean = stripCodePrefix(parashot[0]);\n      if (clean.indexOf('פרשת ') === 0) {\n        return 'מה תרצו לקחת מ' + clean + '?';\n      }\n      return 'מה תרצו לקחת מהפרשה?';\n    }\n\n    const cleaned = parashot.map(stripCodePrefix).map(function (name) {\n      return name.replace(/^פרשת\\s+/, '').trim();\n    });\n\n    if (cleaned.length === 2) {\n      return 'מה תרצו לקחת מפרשות ' + cleaned[0] + ' ו' + cleaned[1] + '?';\n    }\n\n    return 'מה תרצו לקחת מהפרשות?';\n  }\n\n  function readParashaConfigFromWidget() {\n    const el = document.getElementById('current-parasha-config');\n    if (!el) return '';\n    return String(el.textContent || el.innerText || '').trim();\n  }\n\n  function jsonp(params) {\n    return new Promise((resolve, reject) => {\n      const callbackName = '__shortsJsonpCb' + (++state.jsonpCounter);\n      const script = document.createElement('script');\n      const query = new URLSearchParams(params);\n      query.set('prefix', callbackName);\n\n      const cleanup = () => {\n        try { delete window[callbackName]; } catch (e) {}\n        if (script.parentNode) script.parentNode.removeChild(script);\n      };\n\n      const timer = setTimeout(() => {\n        cleanup();\n        reject(new Error('Timeout'));\n      }, 15000);\n\n      window[callbackName] = function (data) {\n        clearTimeout(timer);\n        cleanup();\n        resolve(data);\n      };\n\n      script.onerror = function () {\n        clearTimeout(timer);\n        cleanup();\n        reject(new Error('JSONP failed'));\n      };\n\n      script.src = WEB_APP_URL + (WEB_APP_URL.includes('?') ? '&' : '?') + query.toString();\n      document.body.appendChild(script);\n    });\n  }\n\n  function getTypeMeta(typeKey) {\n    if (!state.data || !state.data.availableTypes) return null;\n    return state.data.availableTypes.find(function (t) {\n      return t.key === typeKey;\n    }) || null;\n  }\n\n  function getCurrentItems() {\n    if (!state.currentType || !state.data || !state.data.itemsByType) return [];\n    return state.data.itemsByType[state.currentType] || [];\n  }\n\n  function scrollToResultIfNeeded() {\n    if (window.innerWidth > 640 || els.resultWrap.hidden) return;\n    setTimeout(function () {\n      els.resultWrap.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n    }, 80);\n  }\n\n  function renderTypeButtons() {\n    els.types.innerHTML = '';\n\n    const types = state.data.availableTypes || [];\n    types.forEach(function (typeObj) {\n      const btn = document.createElement('button');\n      btn.type = 'button';\n      btn.className = 'shorts-type-btn';\n      btn.setAttribute('data-type', typeObj.key);\n\n      if (state.currentType === typeObj.key) {\n        btn.classList.add('is-active');\n      }\n\n      btn.innerHTML =\n        '<span class=\"shorts-type-icon\">' + escapeHtml(typeObj.icon || '') + '</span>' +\n        '<span class=\"shorts-type-text\">' + escapeHtml(typeObj.label) + '</span>';\n\n      btn.addEventListener('click', function () {\n        selectType(typeObj.key);\n      });\n\n      els.types.appendChild(btn);\n    });\n  }\n\n  function renderCurrentItem() {\n    const items = getCurrentItems();\n    const currentIndex = state.currentIndexByType[state.currentType] || 0;\n    const item = items[currentIndex];\n\n    if (!item) {\n      els.resultWrap.hidden = true;\n      state.currentItem = null;\n      return;\n    }\n\n    state.currentItem = item;\n    els.resultWrap.hidden = false;\n\n    const typeMeta = getTypeMeta(state.currentType);\n\n    els.currentType.textContent =\n      (typeMeta && typeMeta.icon ? typeMeta.icon + ' ' : '') +\n      (typeMeta && typeMeta.label ? typeMeta.label : state.currentType);\n\n    els.content.textContent = item.text || '';\n    els.likeCount.textContent = String(item.likes || 0);\n    els.nextBtn.hidden = !(currentIndex < items.length - 1);\n\n    renderTypeButtons();\n  }\n\n  function selectType(typeKey) {\n    state.currentType = typeKey;\n    state.currentIndexByType[typeKey] = 0;\n    renderCurrentItem();\n    setMessage('');\n    scrollToResultIfNeeded();\n  }\n\n  function nextItem() {\n    const items = getCurrentItems();\n    const currentIndex = state.currentIndexByType[state.currentType] || 0;\n\n    if (currentIndex < items.length - 1) {\n      state.currentIndexByType[state.currentType] = currentIndex + 1;\n      renderCurrentItem();\n      scrollToResultIfNeeded();\n    }\n  }\n\n  async function likeCurrentItem() {\n    if (!state.currentItem || !state.currentItem.id) return;\n\n    els.likeBtn.disabled = true;\n    setMessage('שומר...');\n\n    try {\n      const result = await jsonp({\n        action: 'like',\n        id: state.currentItem.id\n      });\n\n      if (!result || !result.ok) {\n        throw new Error(result && result.error ? result.error : 'Like failed');\n      }\n\n      state.currentItem.likes = result.likes || 0;\n      els.likeCount.textContent = String(state.currentItem.likes);\n      setMessage('נשמר');\n      setTimeout(function () {\n        setMessage('');\n      }, 1200);\n\n    } catch (err) {\n      console.error(err);\n      setMessage('לא ניתן היה לשמור כעת');\n    } finally {\n      els.likeBtn.disabled = false;\n    }\n  }\n\n  async function init() {\n    try {\n      setMessage('טוענים קצרים נבחרים מהאתר...');\n\n      state.activeParashotRaw = readParashaConfigFromWidget();\n      state.activeParashotList = parseParashot(state.activeParashotRaw);\n\n      if (!state.activeParashotRaw) {\n        setMessage('לא נמצאה הגדרת פרשה בווידג׳ט current-parasha-config');\n        return;\n      }\n\n      els.question.textContent = buildQuestionFromParashot(state.activeParashotList);\n\n      const data = await jsonp({\n        action: 'bootstrap',\n        activeParashot: state.activeParashotRaw\n      });\n\n      if (!data || !data.ok) {\n        throw new Error(data && data.error ? data.error : 'Bootstrap failed');\n      }\n\n      state.data = data;\n      state.currentType = null;\n      els.resultWrap.hidden = true;\n      renderTypeButtons();\n\n      if (!data.availableTypes || !data.availableTypes.length) {\n        setMessage('עדיין אין קצרים זמינים לפרשה זו.');\n        return;\n      }\n\n      setMessage('');\n\n    } catch (err) {\n      console.error(err);\n      setMessage(err && err.message ? err.message : 'אירעה שגיאה בטעינת הקצרים.');\n    }\n  }\n\n  els.nextBtn.addEventListener('click', nextItem);\n  els.likeBtn.addEventListener('click', likeCurrentItem);\n\n  window.addEventListener('load', function () {\n    setTimeout(init, 250);\n  });\n})();\n</script>\n\n\n\n\n\n\n\n\n<div aria-label=\"ניווט לפי פרשה או מדור\" class=\"quick-nav-seo\">\n  <div class=\"quick-nav-seo-title\">אפשר גם לעבור ישירות ל:</div>\n  <div class=\"quick-nav-seo-links\">\n    <a href=\"https://www.parasha-week.co.il/2025/01/parashot.html\">פרשות&nbsp;</a><a href=\"https://www.parasha-week.co.il/2025/05/medorim.html\">מדורים</a></div>\n</div>\n\n<style>\n.quick-nav-seo{\n  max-width: 860px;\n  margin: 18px auto 0;\n  padding: 16px 16px 18px;\n  background: linear-gradient(180deg, #faf8f3 0%, #f7f4ee 100%);\n  border: 1px solid #e3d9c9;\n  border-radius: 24px;\n  text-align: center;\n  direction: rtl;\n  box-sizing: border-box;\n}\n\n.quick-nav-seo-title{\n  margin: 0 0 14px;\n  font-size: 1rem;\n  font-weight: 700;\n  line-height: 1.45;\n  color: #2f2a23;\n}\n\n.quick-nav-seo-links{\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 12px 14px;\n  flex-wrap: wrap;\n}\n\n.quick-nav-seo-links a{\n  appearance: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 150px;\n  min-height: 44px;\n  padding: 10px 16px;\n  border: 1px solid #e3d9c9;\n  background: rgba(255, 255, 255, 0.95);\n  color: #2f2a23;\n  border-radius: 999px;\n  text-decoration: none;\n  font: inherit;\n  font-size: 1rem;\n  font-weight: 700;\n  line-height: 1.2;\n  box-shadow: 0 2px 8px rgba(90, 70, 25, 0.04);\n  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease, background 0.15s ease;\n  box-sizing: border-box;\n}\n\n.quick-nav-seo-links a:hover,\n.quick-nav-seo-links a:focus-visible{\n  transform: translateY(-1px);\n  box-shadow: 0 8px 20px rgba(90, 70, 25, 0.08);\n  border-color: #ccb27a;\n  background: #fff8eb;\n  outline: none;\n}\n\n@media (max-width: 640px){\n  .quick-nav-seo{\n    padding: 14px 12px 16px;\n    border-radius: 20px;\n  }\n\n  .quick-nav-seo-title{\n    font-size: 0.96rem;\n    margin-bottom: 12px;\n  }\n\n  .quick-nav-seo-links{\n    gap: 10px;\n  }\n\n  .quick-nav-seo-links a{\n    width: 100%;\n    min-width: 0;\n    min-height: 42px;\n    padding: 10px 14px;\n    font-size: 0.97rem;\n  }\n}\n</style>"
}
